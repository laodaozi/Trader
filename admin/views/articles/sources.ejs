<%- include('../partials/layout-top') %>

<style>
  .source-section { margin-bottom: 2rem; }
  .source-section h3 { font-size: 1.1rem; margin-bottom: .75rem; color: #1e293b; }
  .source-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .source-table th { text-align: left; padding: .5rem .75rem; background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #475569; font-weight: 600; }
  .source-table td { padding: .5rem .75rem; border-bottom: 1px solid #f1f5f9; }
  .source-table tr:hover { background: #f8fafc; }
  .source-table .title { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .source-table .date { white-space: nowrap; color: #64748b; }
  .source-table .source { white-space: nowrap; }
  .badge { display: inline-block; padding: .15rem .5rem; border-radius: 4px; font-size: .75rem; font-weight: 600; }
  .badge-manual { background: #dbeafe; color: #1d4ed8; }
  .badge-rss { background: #fef3c7; color: #b45309; }
  .badge-nocontent { background: #fee2e2; color: #b91c1c; }
  .badge-hascontent { background: #dcfce7; color: #166534; }
  .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
  .empty-state p { margin: .5rem 0; }
  .count-bar { display: flex; gap: 1rem; margin-bottom: 1rem; font-size: .85rem; color: #64748b; }
  .count-bar strong { color: #1e293b; }
  .rss-warn { background: #fef3c7; border: 1px solid #fde68a; border-radius: 6px; padding: .75rem 1rem; margin-bottom: 1rem; font-size: .85rem; color: #92400e; }
</style>
</head>
<body>
<%- include('../partials/nav', { active: 'articles' }) %>

<div class="dash-container">
  <h2><%= title %></h2>

  <div class="subnav">
    <a href="/admin/articles" class="subnav-tab">文章列表</a>
    <a href="/admin/articles/sources" class="subnav-tab active">信源管理</a>
    <a href="/admin/articles/stats" class="subnav-tab">数据统计</a>
  </div>

  <div class="count-bar">
    <span>📋 手动提交: <strong><%= sources.manual_total %></strong> 条</span>
    <span>📡 RSS 抓取: <strong><%= sources.rss_total %></strong> 条（含无内容）</span>
  </div>

  <!-- 手动提交 -->
  <div class="source-section">
    <h3>📝 手动提交（URL 优先）</h3>
    <% if (sources.manual && sources.manual.length > 0) { %>
      <table class="source-table">
        <thead><tr><th>标题</th><th>日期</th><th>来源</th><th>状态</th></tr></thead>
        <tbody>
          <% sources.manual.forEach(s => { %>
            <tr>
              <td class="title"><%= s.title %></td>
              <td class="date"><%= s.submitted_at ? s.submitted_at.slice(0,10) : '-' %></td>
              <td class="source"><span class="badge badge-manual">手动</span></td>
              <td>
                <% if (s.enriched) { %>
                  <span class="badge badge-hascontent">已增强</span>
                <% } else { %>
                  <span class="badge badge-nocontent">待处理</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <p>📭 暂无手动提交</p>
        <p>在「文章看板」中使用「添加信源」提交 URL 或文章内容</p>
      </div>
    <% } %>
  </div>

  <!-- RSS 抓取 -->
  <div class="source-section">
    <h3>📡 RSS 抓取（WeWe RSS）</h3>
    <% if (sources.rss && sources.rss.length > 0) { %>
      <% const nocontent = sources.rss.filter(s => s.content_len === 0); %>
      <% if (nocontent.length > 0) { %>
        <div class="rss-warn">⚠️ RSS 账号失效：最近 <%= nocontent.length %> 篇文章内容为空（暂无可用读书账号）。文章有标题但无法获取正文，建议使用手动提交作为主要信源。</div>
      <% } %>
      <table class="source-table">
        <thead><tr><th>标题</th><th>公众号</th><th>日期</th><th>来源</th><th>内容</th></tr></thead>
        <tbody>
          <% sources.rss.forEach(s => { %>
            <tr>
              <td class="title"><%= s.title %></td>
              <td style="font-size:.75rem;color:#64748b;"><%= s.mp_id %></td>
              <td class="date"><%= s.publish_date %></td>
              <td class="source"><span class="badge badge-rss">RSS</span></td>
              <td>
                <% if (s.content_len === 0) { %>
                  <span class="badge badge-nocontent">空</span>
                <% } else { %>
                  <span class="badge badge-hascontent"><%= Math.round(s.content_len / 1000) %>KB</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <p>📡 RSS 暂无数据</p>
        <p>WeWe RSS 数据库可能不可用或抓取已中断</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-bottom') %>
</div>

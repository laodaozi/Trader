<%- include('../partials/layout-top') %>
</head>
<body>
<%- include('../partials/nav', { active: 'reflection' }) %>

<div class="dash-container">
  <h2>🔁 项目复盘 — Loop Learning</h2>
  <p style="font-size:0.85em;color:var(--text-muted);margin:-8px 0 16px">跨模块闭环反思 · AI策略 × 信号命中 × 执行偏差 · 定期与 Claude 复盘</p>

  <!-- 子导航 -->
  <div class="subnav">
    <a href="/admin/trader" class="subnav-tab">概览</a>
    <a href="/admin/trader/strategy" class="subnav-tab">自选池诊断</a>
    <a href="/admin/trader/tracker" class="subnav-tab">信号跟踪</a>
    <a href="/admin/trader/model-library" class="subnav-tab">策略库</a>
    <a href="/admin/trader/backtest" class="subnav-tab">策略回测</a>
    <a href="/admin/trader/watchlist" class="subnav-tab">自选股</a>
    <a href="/admin/trader/article-stats" class="subnav-tab">文章统计</a>
    <a href="/admin/trader/drawdown" class="subnav-tab">回撤统计</a>
    <a href="/admin/trader/reflection" class="subnav-tab active">策略反思</a>
  </div>

  <% if (error) { %>
    <div class="dash-empty" style="margin-top:20px"><p>⚠️ <%= error %></p></div>
  <% } else { %>

  <!-- ── 当前轮动快照 ── -->
  <div class="dash-section" id="rotation-snapshot" style="margin-top:20px">
    <h3 class="dash-section-title">🧭 当前轮动判断</h3>
    <% if (rotationSnapshot) { %>
    <div style="padding:16px;background:var(--cr-surface-alt);border:1px solid var(--cr-border);border-radius:var(--cr-radius);margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
        <div>
          <div style="font-size:11px;color:var(--cr-text-secondary)">主方向</div>
          <div style="font-size:22px;font-weight:700;color:var(--cr-primary)"><%= rotationSnapshot.direction||'—' %></div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--cr-text-secondary)">置信度</div>
          <div style="display:flex;align-items:center;gap:8px;margin-top:4px">
            <div style="width:80px;height:6px;background:var(--cr-border);border-radius:3px">
              <div style="width:<%=rotationSnapshot.confidence||0%>%;height:100%;background:var(--cr-primary);border-radius:3px"></div>
            </div>
            <span style="font-size:13px;font-weight:600"><%= rotationSnapshot.confidence||0 %>%</span>
          </div>
        </div>
        <div style="font-size:10px;color:var(--cr-text-secondary);margin-left:auto">更新: <%= rotationSnapshot.updated_at?rotationSnapshot.updated_at.slice(0,16).replace('T',' '):'—' %></div>
      </div>
      <table class="data-table" style="margin-top:12px;width:100%">
        <tr><td style="width:80px;color:var(--cr-text-secondary);font-size:12px">催化剂</td><td><%= rotationSnapshot.catalyst||'—' %></td></tr>
        <tr><td style="color:var(--cr-text-secondary);font-size:12px">支撑证据</td><td><%= rotationSnapshot.evidence||'—' %></td></tr>
        <tr><td style="color:var(--cr-text-secondary);font-size:12px">领先信号</td><td><%= rotationSnapshot.lead_signals||'—' %></td></tr>
        <tr><td style="color:var(--cr-text-secondary);font-size:12px">观察标的</td><td><%= rotationSnapshot.watchlist||'—' %></td></tr>
        <tr><td style="color:var(--cr-warn);font-size:12px">存疑</td><td style="color:var(--cr-warn)"><%= rotationSnapshot.doubt||'—' %></td></tr>
      </table>
    </div>
    <% } %>
    <details <%=!rotationSnapshot?'open':''%>>
      <summary style="cursor:pointer;font-size:13px;color:var(--cr-primary);margin-bottom:10px"><%= rotationSnapshot?'✏️ 更新判断':'📝 写入首个轮动判断' %></summary>
      <form method="POST" action="/admin/trader/reflection/rotation-snapshot">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px">
          <label style="font-size:12px">主方向<br><input type="text" name="direction" value="<%=(rotationSnapshot&&rotationSnapshot.direction)||''%>" placeholder="如：半导体设备" style="width:100%;margin-top:4px"></label>
          <label style="font-size:12px">置信度 0-100<br><input type="number" name="confidence" min="0" max="100" value="<%=(rotationSnapshot&&rotationSnapshot.confidence)||50%>" style="width:100%;margin-top:4px"></label>
          <label style="font-size:12px">催化剂<br><input type="text" name="catalyst" value="<%=(rotationSnapshot&&rotationSnapshot.catalyst)||''%>" placeholder="政策/事件/季节性" style="width:100%;margin-top:4px"></label>
          <label style="font-size:12px">支撑证据<br><input type="text" name="evidence" value="<%=(rotationSnapshot&&rotationSnapshot.evidence)||''%>" placeholder="信号数量/资金动向" style="width:100%;margin-top:4px"></label>
          <label style="font-size:12px">领先信号标的<br><input type="text" name="lead_signals" value="<%=(rotationSnapshot&&rotationSnapshot.lead_signals)||''%>" placeholder="NX/涨停标的" style="width:100%;margin-top:4px"></label>
          <label style="font-size:12px">观察标的（逗号分隔）<br><input type="text" name="watchlist" value="<%=(rotationSnapshot&&rotationSnapshot.watchlist)||''%>" placeholder="688012, 002371" style="width:100%;margin-top:4px"></label>
        </div>
        <label style="font-size:12px;display:block;margin-top:10px">存疑点<br><input type="text" name="doubt" value="<%=(rotationSnapshot&&rotationSnapshot.doubt)||''%>" placeholder="当前最大的不确定性" style="width:100%;margin-top:4px"></label>
        <button type="submit" class="btn" style="margin-top:14px">保存快照</button>
      </form>
    </details>
  </div>

    <!-- ═══ LLM 策略反思（generate_strategy_reflection.py 产出） ═══ -->
    <% if (llmReflection && llmReflection.reflections && llmReflection.reflections.length > 0) { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">🤖 AI 策略反思
        <span style="font-size:0.65em;font-weight:400;color:var(--text-muted);margin-left:8px"><%= llmReflection.model || '' %> · <%= llmReflection.period || '' %></span>
      </h3>

      <!-- 核心摘要 -->
      <% if (llmReflection.summary) { %>
      <div style="background:rgba(59,130,246,0.06);border-left:3px solid var(--primary);padding:12px 16px;margin:12px 0;border-radius:4px">
        <div style="font-weight:700;color:var(--primary);font-size:0.95em">💡 核心判断</div>
        <div style="margin-top:6px;line-height:1.7;color:var(--text)"><%= llmReflection.summary %></div>
      </div>
      <% } %>

      <!-- 反思卡片 -->
      <% const confColors = { high: '#22c55e', medium: '#f59e0b', low: '#9ca3af' }; %>
      <% llmReflection.reflections.forEach(r => {
        let icon = '📰';
        if (r.section.includes('轮动')) icon = '🔄';
        else if (r.section.includes('标的')) icon = '🎯';
        else if (r.section.includes('因子')) icon = '🔬';
        else if (r.section.includes('事件')) icon = '📡';
        const conf = r.confidence || 'low';
      %>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:14px 16px;margin:10px 0">
        <div style="font-weight:700;font-size:0.9em;color:var(--primary);margin-bottom:8px">
          <%= icon %> <%= r.section %>
          <span style="font-size:0.7em;color:<%= confColors[conf] || '#9ca3af' %>;margin-left:8px"><%= conf %></span>
        </div>
        <div style="font-size:0.88em;line-height:1.75;color:var(--text);white-space:pre-wrap"><%= r.content %></div>
      </div>
      <% }) %>

      <!-- 元数据 -->
      <div style="font-size:0.72em;color:var(--text-muted);text-align:center;padding:8px">
        <%= llmReflection.generated_at || '' %>
        <% if (llmReflection.tokens) { %> | tokens: in=<%= llmReflection.tokens.input %> out=<%= llmReflection.tokens.output %><% } %>
      </div>
    </div>
    <% } else { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">🤖 AI 策略反思</h3>
      <div class="dash-empty" style="padding:20px">
        <p>⚠️ 暂无 LLM 策略反思数据</p>
        <p style="font-size:0.85em;color:var(--text-muted)">请运行: <code>python3.9 core/scripts/generate_strategy_reflection.py</code></p>
      </div>
    </div>
    <% } %>

    <!-- 数据概览卡片 -->
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">📊 数据概览</h3>
      <table class="data-table" style="width:auto">
        <thead>
          <tr><th>数据源</th><th>总条数</th><th>最新日期</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>反思日志</strong> (tracker_reflection.py)</td>
            <td><%= stats.totalReflections %></td>
            <td><%= stats.latestReflection %></td>
          </tr>
          <tr>
            <td><strong>策略执行</strong> (strategy_exec.py)</td>
            <td><%= stats.totalStrategies %></td>
            <td><%= stats.latestStrategy %></td>
          </tr>
          <tr>
            <td><strong>扫描日志</strong> (scanner.py)</td>
            <td><%= stats.totalScannerRuns %></td>
            <td><%= stats.latestScanner %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- 最新反思日志 -->
    <% if (reflections.length > 0) { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">📝 最新反思日志（近20条）</h3>
      <table class="data-table">
        <thead>
          <tr><th>日期</th><th>类型</th><th>概述</th><th>详情</th></tr>
        </thead>
        <tbody>
          <% reflections.forEach(r => { %>
            <tr>
              <td><%= r.date || r.timestamp || '-' %></td>
              <td><%= r.type || r.category || '-' %></td>
              <td><%= (r.summary || r.title || JSON.stringify(r).slice(0, 80)) %></td>
              <td><pre style="margin:0;max-width:500px;white-space:pre-wrap;font-size:0.85em"><%= JSON.stringify(r, null, 2).slice(0, 500) %></pre></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- A1 胜率矩阵 — V7.5 接入 tracker 真实数据 -->
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">📈 策略胜率回顾（tracker 真实标记）</h3>
      <% if (trackerStats) { %>
      <div class="dash-cards" style="justify-content:flex-start;gap:12px;margin-bottom:16px">
        <div class="dash-card" style="flex:0 0 auto;padding:12px 20px;text-align:center">
          <div class="dash-card-value" style="color:var(--cr-positive)"><%= trackerStats.totalHit || 0 %></div>
          <span class="dash-card-label">HIT</span>
        </div>
        <div class="dash-card" style="flex:0 0 auto;padding:12px 20px;text-align:center">
          <div class="dash-card-value" style="color:var(--cr-negative)"><%= trackerStats.totalMiss || 0 %></div>
          <span class="dash-card-label">MISS</span>
        </div>
        <div class="dash-card" style="flex:0 0 auto;padding:12px 20px;text-align:center">
          <div class="dash-card-value"><%= trackerStats.totalPending || 0 %></div>
          <span class="dash-card-label">Pending</span>
        </div>
        <div class="dash-card" style="flex:0 0 auto;padding:12px 20px;text-align:center">
          <div class="dash-card-value" style="color:<%= (trackerStats.globalWinRate||0) >= 60 ? 'var(--cr-positive)' : 'var(--cr-warn)' %>">
            <%= trackerStats.globalWinRate != null ? trackerStats.globalWinRate + '%' : 'N/A' %>
          </div>
          <span class="dash-card-label">全局胜率</span>
        </div>
      </div>
      <% } %>
      <% if (globalWinRates && globalWinRates.length > 0) { %>
      <table class="track-table">
        <thead>
          <tr><th>策略</th><th>胜率</th><th>WIN</th><th>LOSE</th><th>持仓中</th><th>均最终回报</th></tr>
        </thead>
        <tbody>
          <% globalWinRates.forEach(r => { %>
          <tr>
            <td style="font-weight:600"><%= r.strategy %></td>
            <td style="font-weight:700;color:<%= r.winRate >= 60 ? 'var(--cr-positive)' : r.winRate >= 45 ? 'var(--cr-warn)' : 'var(--cr-negative)' %>">
              <%= r.winRate != null ? r.winRate + '%' : 'N/A' %>
            </td>
            <td style="color:var(--cr-positive)"><%= r.win %></td>
            <td style="color:var(--cr-negative)"><%= r.lose %></td>
            <td style="color:var(--cr-text-2)"><%= r.hold %></td>
            <td style="font-weight:600;color:<%= (r.avgFinalReturn||0) >= 0 ? 'var(--cr-positive)' : 'var(--cr-negative)' %>">
              <%= r.avgFinalReturn != null ? r.avgFinalReturn + '%' : '—' %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <div class="dash-empty"><p>暂无 tracker 数据。在「信号跟踪」页标记 HIT/MISS 后此处自动汇总。</p></div>
      <% } %>
    </div>

    <!-- 最新策略执行 -->
    <% if (strategies.length > 0) { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">⚙️ 最新策略执行（近10次）</h3>
      <table class="data-table">
        <thead>
          <tr><th>日期</th><th>持仓数</th><th>建议动作</th><th>概述</th></tr>
        </thead>
        <tbody>
          <% strategies.forEach(s => { %>
            <tr>
              <td><%= s.date || s.timestamp || '-' %></td>
              <td><%= s.position_count || s.positions?.length || '-' %></td>
              <td><%= s.action || s.recommendation || '-' %></td>
              <td><pre style="margin:0;max-width:400px;white-space:pre-wrap;font-size:0.85em"><%= JSON.stringify(s, null, 2).slice(0, 300) %></pre></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- 最新扫描结果 -->
    <% if (scannerEntries.length > 0) { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">🔍 最新扫描结果（近5次）</h3>
      <table class="data-table">
        <thead>
          <tr><th>日期</th><th>信号数</th><th>模型</th><th>详情</th></tr>
        </thead>
        <tbody>
          <% scannerEntries.forEach(e => { %>
            <tr>
              <td><%= e.date || e.timestamp || '-' %></td>
              <td><%= e.signal_count || e.signals?.length || '-' %></td>
              <td><%= e.model || e.source || '-' %></td>
              <td><pre style="margin:0;max-width:400px;white-space:pre-wrap;font-size:0.85em"><%= JSON.stringify(e, null, 2).slice(0, 300) %></pre></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/layout-bottom') %>
</body>
</html>

<%- include('../partials/layout-top') %>
<style>
/* ── Admin Dashboard V7.9 ── */
.adm-top { display:flex; align-items:center; gap:12px; margin:16px 0 20px; padding:14px 18px; background:var(--surface-2,#1e293b); border-radius:8px; border-left:4px solid var(--success,#22c55e); }
.adm-top.warn { border-left-color:var(--warn,#f59e0b); }
.adm-top.danger { border-left-color:var(--danger,#ef4444); }
.adm-top-label { font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); letter-spacing:.8px; flex-shrink:0; }
.adm-top-text { font-size:14px; font-weight:600; color:var(--text-primary,#f1f5f9); flex:1; }
.adm-top-time { font-size:11px; color:var(--text-muted); flex-shrink:0; }

/* 管线状态行 */
.pipe-row { display:flex; gap:8px; flex-wrap:wrap; margin:14px 0; }
.pipe-item { display:flex; align-items:center; gap:6px; padding:7px 12px; border-radius:6px; font-size:12px; font-weight:600; }
.pipe-item.ok   { background:rgba(34,197,94,.1);  color:#4ade80; border:1px solid rgba(34,197,94,.25); }
.pipe-item.warn { background:rgba(245,158,11,.1); color:#fbbf24; border:1px solid rgba(245,158,11,.25); }
.pipe-item.dead { background:rgba(239,68,68,.1);  color:#f87171; border:1px solid rgba(239,68,68,.25); }
.pipe-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }
.pipe-item.ok .pipe-dot   { background:#4ade80; }
.pipe-item.warn .pipe-dot { background:#fbbf24; }
.pipe-item.dead .pipe-dot { background:#f87171; }
.pipe-time { font-size:10px; font-weight:400; opacity:.7; margin-left:2px; }

/* 指标卡片 */
.kpi-row { display:flex; gap:12px; flex-wrap:wrap; margin:14px 0; }
.kpi-card { flex:1; min-width:120px; max-width:200px; background:var(--surface-2,#1e293b); border:1px solid var(--border,#334155); border-radius:8px; padding:14px 16px; }
.kpi-label { font-size:10px; font-weight:700; text-transform:uppercase; color:var(--text-muted); letter-spacing:.7px; margin-bottom:6px; }
.kpi-val { font-size:26px; font-weight:800; color:var(--text-primary,#f1f5f9); line-height:1; }
.kpi-val.ok   { color:#4ade80; }
.kpi-val.warn { color:#fbbf24; }
.kpi-val.bad  { color:#f87171; }
.kpi-sub { font-size:11px; color:var(--text-muted); margin-top:5px; line-height:1.4; }

/* 结论块 */
.concl { margin:14px 0; padding:10px 14px; border-radius:6px; font-size:12px; line-height:1.65; }
.concl.ok   { background:rgba(34,197,94,.06);  border-left:3px solid #22c55e; color:#86efac; }
.concl.warn { background:rgba(245,158,11,.06); border-left:3px solid #f59e0b; color:#fde68a; }
.concl.bad  { background:rgba(239,68,68,.06);  border-left:3px solid #ef4444; color:#fca5a5; }
.concl strong { font-weight:700; }

/* 信号分布条 */
.dist-row { display:flex; height:8px; border-radius:4px; overflow:hidden; margin:8px 0 4px; gap:1px; }
.dist-seg { height:100%; transition:width .3s; }
.dist-legend { display:flex; gap:14px; font-size:10px; color:var(--text-muted); }
.dist-dot { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:3px; vertical-align:middle; }

/* section 标题带结论 */
.sec-head { display:flex; align-items:baseline; gap:10px; margin:20px 0 10px; }
.sec-title { font-size:13px; font-weight:700; color:var(--text-primary,#f1f5f9); }
.sec-concl { font-size:11px; color:var(--text-muted); }
.sec-concl.ok   { color:#4ade80; }
.sec-concl.warn { color:#fbbf24; }
.sec-concl.bad  { color:#f87171; }

/* 反思摘要 */
.refl-item { padding:8px 0; border-bottom:1px solid var(--border,#334155); }
.refl-item:last-child { border-bottom:none; }
.refl-section { font-size:10px; font-weight:700; color:var(--primary,#3b82f6); text-transform:uppercase; margin-bottom:3px; }
.refl-content { font-size:12px; color:var(--text-secondary,#94a3b8); line-height:1.55; }
</style>
</head>
<body>
<%- include('../partials/nav', { active: 'trader' }) %>

<div class="dash-container">  <!-- 子导航 -->
  <div class="subnav">
    <a href="/admin/trader"              class="subnav-tab active">今日行动</a>
    <a href="/admin/trader/rotation"     class="subnav-tab">市场状态</a>
    <a href="/admin/trader/watchlist"    class="subnav-tab">自选池</a>
    <a href="/admin/trader/event-feed"   class="subnav-tab">事件录入</a>
    <a href="/admin/trader/reflection"   class="subnav-tab">策略反思</a>
    <a href="/admin/trader/tracker"      class="subnav-tab">信号归档</a>
  </div>

  <%
    // ── 系统状态判断 ──
    var pipeOk = 0, pipeWarn = 0;
    if (ops) {
      Object.values(ops).forEach(function(o){ o.ran ? pipeOk++ : pipeWarn++; });
    }
    var sysStatus = pipeWarn === 0 ? 'ok' : pipeWarn <= 1 ? 'warn' : 'danger';
    var sysMsg = pipeWarn === 0
      ? '所有管线今日已运行，系统正常'
      : pipeWarn + ' 条管线未运行，请检查对应 cron log';

    // ── 信号分布 ──
    var sigTotal  = latestStrategy ? (latestStrategy.attack + latestStrategy.buy + latestStrategy.ambush + latestStrategy.watch) : 0;
    var sigAttack = latestStrategy ? latestStrategy.attack : 0;
    var sigBuy    = latestStrategy ? latestStrategy.buy    : 0;
    var sigAmbush = latestStrategy ? latestStrategy.ambush : 0;
    var sigWatch  = latestStrategy ? latestStrategy.watch  : 0;
    var pct = function(n){ return sigTotal > 0 ? (n/sigTotal*100).toFixed(0) : 0; };

    // ── 跟踪胜率结论 ──
    var trackerConcl = '', trackerConclCls = 'warn';
    if (trackerSummary) {
      var h20 = trackerSummary.allByHorizon && trackerSummary.allByHorizon[20];
      if (h20) {
        var resolved = (h20.verdicts.HIT||0) + (h20.verdicts.MISS||0);
        var wr = resolved > 0 ? Math.round((h20.verdicts.HIT||0)/resolved*100) : null;
        if (wr !== null) {
          trackerConclCls = wr >= 50 ? 'ok' : wr >= 40 ? 'warn' : 'bad';
          trackerConcl = '20日窗口裁决胜率 ' + wr + '%（WIN=' + (h20.verdicts.HIT||0) + ' LOSE=' + (h20.verdicts.MISS||0) + '）· EXPIRED ' + (h20.verdicts.EXPIRED||0) + ' 条（占比 ' + (h20.total>0?Math.round((h20.verdicts.EXPIRED||0)/h20.total*100):0) + '%，需关注 OHLC 回填）';
        }
      }
    }

    // ── 今日运营时间 ──
    var nowStr = new Date().toLocaleString('zh-CN',{timeZone:'Asia/Shanghai',hour12:false}).replace(/\//g,'-');
  %>

  <!-- ① 系统状态一行结论 -->
  <div class="adm-top <%= sysStatus %>">
    <span class="adm-top-label">系统状态</span>
    <span class="adm-top-text"><%- sysMsg %></span>
    <span class="adm-top-time"><%= nowStr %></span>
  </div>

  <!-- ② 管线状态行 -->
  <% if (ops) { %>
  <div class="pipe-row">
    <% Object.entries(ops).forEach(function(entry){ var k=entry[0], o=entry[1]; %>
    <div class="pipe-item <%= o.ran ? 'ok' : 'dead' %>">
      <div class="pipe-dot"></div>
      <%= o.label %>
      <% if (o.ran && o.mtime) { %><span class="pipe-time"><%= o.mtime.slice(11,16) %></span><% } %>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- ③ 核心 KPI 行 -->
  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-label">今日选股</div>
      <div class="kpi-val <%= sigBuy+sigAttack > 0 ? 'ok' : 'warn' %>"><%= latestStrategy ? latestStrategy.count || sigTotal : '—' %></div>
      <div class="kpi-sub"><%= latestStrategy ? latestStrategy.date : '无数据' %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">均分</div>
      <div class="kpi-val <%= latestStrategy && latestStrategy.avgScore >= 60 ? 'ok' : 'warn' %>"><%= latestStrategy ? latestStrategy.avgScore : '—' %></div>
      <div class="kpi-sub">满分 100 · 60+ 可信</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">跟踪记录</div>
      <div class="kpi-val"><%= trackerSummary ? trackerSummary.totalRecords : '—' %></div>
      <div class="kpi-sub">EXPIRED <%= trackerSummary && trackerSummary.allByHorizon && trackerSummary.allByHorizon[20] ? (trackerSummary.allByHorizon[20].verdicts.EXPIRED||0) : '—' %> 条</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">市场温度</div>
      <% var temp = timing && timing.history && timing.history.length ? timing.history[timing.history.length-1] : null; %>
      <div class="kpi-val <%= temp && temp.phase==='进攻' ? 'ok' : temp && temp.phase==='防守' ? 'bad' : 'warn' %>">
        <%= temp ? Math.round((temp.temp||0)*100) + '°' : '—' %>
      </div>
      <div class="kpi-sub"><%= temp ? temp.phase_desc || temp.phase || '—' : '无数据' %></div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">回测模型</div>
      <div class="kpi-val"><%= backtestReports ? backtestReports.length : '—' %></div>
      <div class="kpi-sub"><a href="/admin/trader/backtest" style="color:var(--primary,#3b82f6);font-size:11px">查看 →</a></div>
    </div>
  </div>

  <!-- ④ 今日信号分布 + 结论 -->
  <% if (latestStrategy) { %>
  <div class="sec-head">
    <span class="sec-title">📋 今日信号分布</span>
    <span class="sec-concl <%= sigBuy+sigAttack >= 10 ? 'ok' : sigBuy+sigAttack >= 3 ? 'warn' : 'bad' %>">
      <%= sigBuy+sigAttack >= 10 ? '做多信号充足，可正常择股' : sigBuy+sigAttack >= 3 ? '做多信号偏少，谨慎操作' : '信号极少，观望为主' %>
    </span>
  </div>
  <div class="dist-row">
    <div class="dist-seg" style="width:<%= pct(sigAttack) %>%;background:#ef4444" title="进攻 <%= sigAttack %>"></div>
    <div class="dist-seg" style="width:<%= pct(sigBuy)    %>%;background:#22c55e" title="买入 <%= sigBuy %>"></div>
    <div class="dist-seg" style="width:<%= pct(sigAmbush) %>%;background:#3b82f6" title="埋伏 <%= sigAmbush %>"></div>
    <div class="dist-seg" style="width:<%= pct(sigWatch)  %>%;background:#475569" title="观望 <%= sigWatch %>"></div>
  </div>
  <div class="dist-legend">
    <span><span class="dist-dot" style="background:#ef4444"></span>进攻 <b><%= sigAttack %></b></span>
    <span><span class="dist-dot" style="background:#22c55e"></span>买入 <b><%= sigBuy %></b></span>
    <span><span class="dist-dot" style="background:#3b82f6"></span>埋伏 <b><%= sigAmbush %></b></span>
    <span><span class="dist-dot" style="background:#475569"></span>观望 <b><%= sigWatch %></b></span>
  </div>
  <p style="margin-top:10px"><a href="/admin/trader/strategy?date=<%= latestStrategy.date %>" class="btn">查看完整诊断 →</a></p>
  <% } %>

  <!-- ④b 今日主线事件（管线去重后 top4） -->
  <% if (typeof narrativeEvents !== 'undefined' && narrativeEvents && narrativeEvents.length > 0) { %>
  <div class="sec-head" style="margin-top:18px">
    <span class="sec-title">📰 今日主线</span>
    <a href="/admin/trader/event-feed" style="font-size:11px;color:var(--primary,#3b82f6)">全部早报 →</a>
  </div>
  <div style="display:flex;flex-direction:column;gap:7px">
    <% narrativeEvents.forEach(function(ev) { %>
    <div style="display:flex;align-items:flex-start;gap:8px;padding:9px 12px;border:1px solid var(--border,#334155);border-radius:7px;font-size:12px">
      <span style="font-weight:700;color:var(--primary,#3b82f6);flex-shrink:0;min-width:22px">#<%= ev.rank %></span>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;color:var(--text-primary,#f1f5f9);line-height:1.4;margin-bottom:4px"><%= ev.title %><% if (ev.trading_window) { %><span style="color:#f59e0b;font-size:10px;margin-left:5px">⏱ <%= ev.trading_window %></span><% } %></div>
        <% if (ev.stock_mapping && ev.stock_mapping.length > 0) { %>
        <div style="display:flex;flex-wrap:wrap;gap:4px">
          <% ev.stock_mapping.forEach(function(s) { %>
          <span style="font-size:10px;padding:1px 6px;border-radius:3px;background:<%= s.type==='long'?'rgba(34,197,94,.12)':'rgba(239,68,68,.12)' %>;color:<%= s.type==='long'?'#4ade80':'#f87171' %>;font-family:monospace"><%= s.name || s.code %></span>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- ⑤ 跟踪胜率结论（摘要，详见信号归档） -->
  <% if (trackerSummary && trackerConcl) { %>
  <div class="sec-head" style="margin-top:22px">
    <span class="sec-title">📈 信号跟踪诊断</span>
    <a href="/admin/trader/tracker" style="font-size:11px;color:var(--primary,#3b82f6)">明细 →</a>
  </div>
  <div class="concl <%= trackerConclCls %>">
    <%- trackerConcl %>
    <span style="display:block;margin-top:6px;font-size:11px">
      策略胜率明细 → <a href="/admin/trader/tracker" style="color:var(--primary,#3b82f6)">信号归档</a>
    </span>
  </div>
  <% } %>

  <!-- ⑥ 策略反思摘要（如有） -->
  <% if (typeof llmReflection !== 'undefined' && llmReflection && llmReflection.reflections) { %>
  <div class="sec-head" style="margin-top:22px">
    <span class="sec-title">🔁 今日策略反思</span>
    <span class="sec-concl"><%= llmReflection.generated_at ? llmReflection.generated_at.slice(0,16).replace('T',' ') : '' %> · <%= llmReflection.model || '' %></span>
    <a href="/admin/trader/reflection" style="font-size:11px;color:var(--primary,#3b82f6);margin-left:auto">完整反思 →</a>
  </div>
  <div style="background:var(--surface-2,#1e293b);border:1px solid var(--border,#334155);border-radius:8px;padding:14px 16px">
    <% llmReflection.reflections.slice(0,2).forEach(function(r){ %>
    <div class="refl-item">
      <div class="refl-section"><%= r.section || '' %></div>
      <div class="refl-content"><%= (r.content||'').slice(0,160) %><%= (r.content||'').length>160?'…':'' %></div>
    </div>
    <% }); %>
  </div>
  <% } %>

</div>
<%- include('../partials/layout-bottom') %>

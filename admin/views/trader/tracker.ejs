<%- include('../partials/layout-top') %>
</head>
<body>
<%- include('../partials/nav', { active: 'trader' }) %>

<div class="dash-container">
  <h2><%= title %></h2>  <!-- 子导航 -->
  <%- include('../partials/trader-subnav') %>

  <!-- 档2: 信号复盘组 子模块入口 -->
  <div class="subgroup-entry" style="display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 4px">
    <a href="/admin/trader/reflection" class="subgroup-link">🤖 策略反思</a>
    <a href="/admin/trader/drawdown" class="subgroup-link">📉 回撤监控</a>
    <a href="/admin/trader/backtest" class="subgroup-link">📜 回测报告</a>
  </div>

  <% if (error) { %>
    <div class="dash-empty" style="margin-top:20px"><p>⚠️ <%= error %></p></div>
  <% } else if (trackerSummary) { %>

  <%
    // ── 置顶诊断结论 ──
    var h20 = trackerSummary.allByHorizon && trackerSummary.allByHorizon[20];
    var h10 = trackerSummary.allByHorizon && trackerSummary.allByHorizon[10];
    var h5  = trackerSummary.allByHorizon && trackerSummary.allByHorizon[5];
    function resolvedWR(stat) {
      if (!stat) return null;
      var r = (stat.verdicts.HIT||0) + (stat.verdicts.MISS||0);
      return r > 0 ? Math.round((stat.verdicts.HIT||0)/r*100) : null;
    }
    var wr20 = resolvedWR(h20), wr10 = resolvedWR(h10), wr5 = resolvedWR(h5);
    var expiredPct20 = h20 && h20.total > 0 ? Math.round((h20.verdicts.EXPIRED||0)/h20.total*100) : null;
    var bestWR = Math.max(wr20||0, wr10||0, wr5||0);
    var conclCls = bestWR >= 50 ? 'ok' : bestWR >= 40 ? 'warn' : 'bad';

    // 结论文字
    var diagnosis = [];
    if (wr20 !== null) diagnosis.push('20日胜率 ' + wr20 + '%');
    if (wr10 !== null) diagnosis.push('10日胜率 ' + wr10 + '%');
    if (wr5  !== null) diagnosis.push('5日胜率 '  + wr5  + '%');
    if (expiredPct20 !== null && expiredPct20 > 60) {
      diagnosis.push('⚠ ' + expiredPct20 + '% 信号 EXPIRED（target 距离过远或 OHLC 未回填）');
    }
  %>

  <!-- ── 置顶结论 ── -->
  <div style="margin:16px 0;padding:12px 16px;border-radius:8px;border-left:4px solid <%= conclCls==='ok'?'#22c55e':conclCls==='warn'?'#f59e0b':'#ef4444' %>;background:rgba(<%= conclCls==='ok'?'34,197,94':conclCls==='warn'?'245,158,11':'239,68,68' %>,.06)">
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-muted);letter-spacing:.8px;margin-bottom:5px">跟踪诊断结论</div>
    <div style="font-size:13px;font-weight:600;color:<%= conclCls==='ok'?'#4ade80':conclCls==='warn'?'#fbbf24':'#f87171' %>">
      <%= diagnosis.join(' · ') %>
    </div>
    <div style="font-size:11px;color:var(--text-muted);margin-top:5px;line-height:1.55">
      <% if (expiredPct20 !== null && expiredPct20 > 60) { %>
        建议：① 排查 tracker_closer OHLC 回填是否正常（当前 n_bars=0）；② 评估 5日 horizon 是否保留（裁决率 <%= (trackerSummary && trackerSummary.overall && trackerSummary.overall.adjudicationRate != null) ? trackerSummary.overall.adjudicationRate + '%' : 'N/A' %>）
      <% } else { %>
        信号裁决链运行正常，持续观察胜率趋势
      <% } %>
    </div>
  </div>

    <!-- ── 胜率诊断卡（按策略分组） ── -->
    <% if (globalWinRates && globalWinRates.length > 0) { %>
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">🎯 策略胜率诊断</h3>
      <div class="dash-cards" style="justify-content:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <% globalWinRates.forEach(function(g) {
          var wr = g.winRate;
          var isStrong = wr !== null && wr >= 50;
          var isWeak = wr !== null && wr < 40;
          var color = isStrong ? 'var(--success)' : isWeak ? 'var(--danger)' : 'var(--warn)';
        %>
        <div class="dash-card" style="flex:0 0 auto;min-width:160px;padding:14px 18px">
          <div style="font-size:11px;color:var(--text-muted);font-weight:600;margin-bottom:6px"><%= g.strategy %></div>
          <div style="font-size:28px;font-weight:800;color:<%= color %>"><%= wr !== null ? wr + '%' : '—' %></div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:4px">WIN=<%= g.win %> LOSE=<%= g.lose %> HOLD=<%= g.hold %></div>
          <% if (g.avgFinalReturn !== null) { %>
          <div style="font-size:11px;margin-top:3px;color:<%= g.avgFinalReturn >= 0 ? 'var(--success)' : 'var(--danger)' %>">avg收益 <%= g.avgFinalReturn > 0 ? '+' : '' %><%= g.avgFinalReturn %>%</div>
          <% } %>
          <% if (g.hitStopRate !== null && g.hitStopRate >= 80) { %>
          <div style="margin-top:6px;padding:4px 8px;background:rgba(239,68,68,0.1);border-left:3px solid var(--danger);border-radius:0 4px 4px 0;font-size:10px;color:var(--danger);font-weight:600">⚠ 止损触发率 <%= g.hitStopRate %>% — 止损线偏紧</div>
          <% } %>
        </div>
        <% }); %>
      </div>
      <% var bandanG = (globalWinRates.filter(function(g){return g.strategy==='波段';}))[0]; %>
      <% if (bandanG && bandanG.winRate !== null && bandanG.winRate < 35) { %>
      <div style="padding:10px 14px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:8px;font-size:12px;line-height:1.6">
        <strong style="color:var(--warn)">📋 波段诊断</strong>：胜率 <%= bandanG.winRate %>%（低于随机基准50%），止损触发率 <%= bandanG.hitStopRate %>%，avg最大收益 +<%= bandanG.avgMaxReturn %>%，avg最大回撤 <%= bandanG.avgMaxDd %>%。
        <strong>根因</strong>：票能涨，但途中回撤触发止损被震出。建议：止损线放宽1.5-2个百分点或改用ATR动态止损。
      </div>
      <% } %>
    </div>
    <% } %>

    <!-- 全局周期统计 -->
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">📊 全量统计（按周期）</h3>
      <table class="data-table" style="width:auto">
        <thead>
          <tr><th>周期</th><th>总数</th><th>WIN</th><th>LOSE</th><th>HOLD</th><th>NODATA</th><th>均收益</th></tr>
        </thead>
        <tbody>
          <% [5,10,20].forEach(function(h) {
            var stat = trackerSummary.allByHorizon[h];
            if (!stat) return; %>
            <tr>
              <td><strong><%= h %>日</strong></td>
              <td><%= stat.total %></td>
              <td class="track-hit"><%= stat.verdicts.HIT || 0 %></td>
              <td class="track-miss"><%= stat.verdicts.MISS || 0 %></td>
              <td class="track-neutral"><%= (stat.verdicts.PENDING || 0) + (stat.verdicts.NEUTRAL || 0) %></td>
              <td class="track-nodata"><%= stat.verdicts.NODATA || 0 %></td>
              <td><strong><%= stat.avgReturn %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- 个股命中率 -->
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">🎯 个股命中率
        <% var activeSummary = trackerSummary.stockSummary.filter(function(s){ return (s.hit||0)+(s.miss||0) > 0; }); %>
        <span style="font-weight:400;font-size:12px;color:var(--text-muted)">已裁决 <%= activeSummary.length %> 只 · <a href="#all-stocks" onclick="document.getElementById('all-stocks-block').style.display='block';this.style.display='none';return false;" style="color:var(--primary)">展开全部 <%= trackerSummary.stockSummary.length %> 只</a></span>
      </h3>
      <table class="data-table">
        <thead>
          <tr><th>代码</th><th>名称</th><th>信号类型</th><th>总数</th><th>HIT</th><th>MISS</th><th>PENDING</th><th>NODATA</th><th>命中率</th></tr>
        </thead>
        <tbody>
          <% activeSummary.forEach(s => { %>
            <tr>
              <td class="track-mono">
                <a href="/admin/trader/tracker/stock/<%= s.code %>" class="track-link"><%= s.code %></a>
              </td>
              <td><%= s.name %></td>
              <td><%= s.signal_type %></td>
              <td><%= s.total %></td>
              <td class="track-success"><%= s.hit %></td>
              <td class="track-danger"><%= s.miss %></td>
              <td class="track-pending"><%= s.pending %></td>
              <td class="track-nodata"><%= s.nodata %></td>
              <td class="track-bold"><%= s.hitRate %></td>
            </tr>
          <% }) %>
          <% if (activeSummary.length === 0) { %>
          <tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:16px">暂无已裁决记录（HIT/MISS=0），信号仍在跟踪窗口内</td></tr>
          <% } %>
        </tbody>
      </table>
      <!-- 折叠区：全量 -->
      <div id="all-stocks-block" style="display:none;margin-top:12px">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px;font-weight:600">全量列表（含无裁决记录的标的）</div>
        <table class="data-table">
          <thead>
            <tr><th>代码</th><th>名称</th><th>信号类型</th><th>总数</th><th>HIT</th><th>MISS</th><th>PENDING</th><th>NODATA</th><th>命中率</th></tr>
          </thead>
          <tbody>
            <% trackerSummary.stockSummary.forEach(s => { %>
              <tr>
                <td class="track-mono">
                  <a href="/admin/trader/tracker/stock/<%= s.code %>" class="track-link"><%= s.code %></a>
                </td>
                <td><%= s.name %></td>
                <td><%= s.signal_type %></td>
                <td><%= s.total %></td>
                <td class="track-success"><%= s.hit %></td>
                <td class="track-danger"><%= s.miss %></td>
                <td class="track-pending"><%= s.pending %></td>
                <td class="track-nodata"><%= s.nodata %></td>
                <td class="track-bold"><%= s.hitRate %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 筛选器 + 明细 -->
    <div class="dash-section" style="margin-top:20px">
      <h3 class="dash-section-title">📋 信号明细</h3>
      <div class="toolbar" style="margin-top:0">
        <span style="font-weight:600;font-size:13px">日期:</span>
        <select onchange="const h=document.getElementById('horizonSel').value;location.href='/admin/trader/tracker?date='+this.value+'&horizon='+h" style="min-width:140px">
          <% (trackerSummary.dates || []).forEach(d => { %>
            <option value="<%= d %>" <%= d === currentDate ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
        <span style="font-weight:600;font-size:13px;margin-left:12px">周期:</span>
        <select id="horizonSel" onchange="const d='<%= currentDate %>';location.href='/admin/trader/tracker?date='+d+'&horizon='+this.value">
          <% [5,10,20].forEach(h => { %>
            <option value="<%= h %>" <%= h === currentHorizon ? 'selected' : '' %>><%= h %>日</option>
          <% }) %>
        </select>
        <span class="count"><%= records.length %> 条记录</span>
      </div>

      <div style="overflow-x:auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>代码</th>
              <th>名称</th>
              <th>信号</th>
              <th>策略</th>
              <th>得分</th>
              <th>入场</th>
              <th>止损</th>
              <th>目标</th>
              <th>结果</th>
              <th>最大收益</th>
              <th>最大回撤</th>
              <th>最终收益</th>
              <th>止损触发</th>
              <th>K线数</th>
              <th>跟踪日期</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% records.forEach(r => { %>
              <tr>
                <td class="track-mono"><a href="/admin/trader/tracker/stock/<%= r.code %>" class="track-link"><%= r.code %></a></td>
                <td><%= r.name %></td>
                <td><%= r.signal_type %></td>
                <td><%= r.strategy %></td>
                <td><%= r.score %></td>
                <td><%= r.entry %></td>
                <td><%= r.stop %></td>
                <td class="track-sm"><%= (r.targets || []).join(', ') %></td>
                <td class="<%= r.result === 'HIT' ? 'track-hit' : r.result === 'MISS' ? 'track-miss' : 'track-nodata' %>"><%= r.result %></td>
                <td class="<%= r.max_return > 0 ? 'track-success' : 'track-danger' %>"><%= (r.max_return * 100).toFixed(1) %>%</td>
                <td class="<%= r.max_dd < 0 ? 'track-danger' : '' %>"><%= (r.max_dd * 100).toFixed(1) %>%</td>
                <td class="<%= r.final_return > 0 ? 'track-success' : 'track-danger' %>"><%= (r.final_return * 100).toFixed(1) %>%</td>
                <td class="<%= r.hit_stop ? 'track-danger' : '' %>" style="font-size:11px;font-weight:<%= r.hit_stop ? 600 : 400 %>"><%= r.hit_stop ? '⚠ 触发' : '—' %></td>
                <td><%= r.n_bars %></td>
                <td class="track-sm"><%= r.track_date %></td>
                <td style="font-size:11px"><a href="/admin/trader/tracker/stock/<%= r.code %>" style="text-decoration:none;color:var(--primary);white-space:nowrap">→个股</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/layout-bottom') %>

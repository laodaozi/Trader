<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/style.css" />
<style>
  /* ===== Style B: Engineering Document ===== */
  :root {
    --bg: #F7F8FA;
    --text: #2C3E50;
    --text-muted: #5A6B7C;
    --border: #D8DEE4;
    --primary: #2D5D7C;
    --primary-light: #4A7D9C;
    --primary-pale: #E8EFF4;
    --accent-amber: #C17D2A;
    --accent-pale: #FDF3E3;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    padding: 28px 24px 60px;
  }
  .diagram {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* headings */
  .diagram h1 { font-size: 22px; font-weight: 600; color: var(--primary); margin-bottom: 6px; letter-spacing: 0.02em; }
  .diagram h2 { font-size: 17px; font-weight: 600; color: var(--primary); margin: 32px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--border); }
  .diagram h3 { font-size: 14px; font-weight: 600; color: var(--primary-light); margin: 20px 0 8px; }
  .diagram h4 { font-size: 13px; font-weight: 600; margin: 16px 0 6px; }
  .diagram h5 { font-size: 12px; font-weight: 600; color: var(--text-muted); margin: 12px 0 4px; }

  /* paragraphs */
  .diagram p { margin: 4px 0 8px; font-size: 13px; }
  .diagram blockquote {
    margin: 8px 0; padding: 8px 14px;
    border-left: 3px solid var(--accent-amber);
    background: var(--accent-pale);
    font-size: 12px; color: var(--text-muted);
    border-radius: 0 6px 6px 0;
  }
  .diagram blockquote p { margin: 2px 0; }

  /* horizontal rules */
  .diagram hr { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

  /* code blocks */
  .diagram pre {
    background: #1E293B; color: #E2E8F0;
    padding: 14px 18px; border-radius: 8px;
    font-size: 11.5px; line-height: 1.55;
    overflow-x: auto; margin: 10px 0;
  }
  .diagram code {
    background: var(--primary-pale); color: var(--primary);
    padding: 1px 5px; border-radius: 3px; font-size: 11.5px;
  }
  .diagram pre code {
    background: none; color: inherit; padding: 0; border-radius: 0;
  }

  /* tables */
  .diagram table {
    width: 100%; border-collapse: collapse;
    font-size: 12px; margin: 10px 0 16px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .diagram th {
    background: var(--primary); color: #fff;
    padding: 8px 12px; text-align: left;
    font-weight: 500; font-size: 11px;
  }
  .diagram td {
    padding: 7px 12px;
    border-bottom: 1px solid var(--border);
  }
  .diagram tr:last-child td { border-bottom: none; }

  /* lists */
  .diagram ul, .diagram ol { margin: 6px 0 10px 18px; font-size: 13px; }
  .diagram li { margin: 3px 0; }

  /* links */
  .diagram a { color: var(--primary); text-decoration: none; }
  .diagram a:hover { text-decoration: underline; }

  /* strong / bold */
  .diagram strong { color: var(--primary); }

  /* meta line after h1 (emoji-free version marker) */
  .diagram h1 + p { font-size: 11px; color: var(--text-muted); margin-bottom: 20px; }

  /* Status badges */
  .pill-ok {
    display: inline-block;
    background: #dcfce7; color: #166534;
    padding: 1px 7px; border-radius: 10px;
    font-size: 10px; font-weight: 600;
  }
  .pill-warn {
    display: inline-block;
    background: #fef3c7; color: #92400e;
    padding: 1px 7px; border-radius: 10px;
    font-size: 10px; font-weight: 600;
  }

  /* page footer */
  .page-footer {
    margin-top: 40px; padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 11px; color: var(--text-muted);
  }
</style>
</head>
<body>

<!-- V9.1: 实时系统状态面板（数据来自 /admin/api/system/status） -->
<% if (typeof sysStatus !== 'undefined' && sysStatus) { %>
<div style="max-width:1100px;margin:0 auto 20px;padding:14px 18px;background:#fff;border:1px solid var(--border,#D8DEE4);border-radius:8px;font-size:12px;line-height:1.6">
  <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
    <!-- 版本 -->
    <span style="font-weight:700;color:var(--primary,#2D5D7C)">🔄 <%= sysStatus.version || version %></span>
    <!-- 健康状态 -->
    <% var hc = sysStatus.health||''; var hLabel = hc.includes('healthy') ? '正常' : hc.includes('degraded') ? '降级' : '异常';
       var hCls = hc.includes('healthy') ? 'pill-ok' : 'pill-warn'; %>
    <span class="<%= hCls %>">状态：<%= hLabel %></span>
    <!-- 管线 -->
    <span>管线：<strong><%= sysStatus.pipeline.ran %>/<%= sysStatus.pipeline.total %></strong> 已运行</span>
    <!-- 运行时长 -->
    <span>运行：<strong><%= Math.floor(sysStatus.uptime_seconds/3600) %>h <%= Math.floor((sysStatus.uptime_seconds%3600)/60) %>m</strong></span>
    <!-- 陈旧数据警告 -->
    <% if (sysStatus.stale_items && sysStatus.stale_items.length > 0) { %>
    <span style="color:#92400e">⚠ 陈旧：
      <% sysStatus.stale_items.forEach(function(s,i){ %><%= i>0?' · ':'' %><%= s.label %> <strong><%= Math.round(s.age_hours) %>h</strong><% }) %>
    </span>
    <% } %>
  </div>
  <!-- 数据新鲜度迷你行 -->
  <div style="margin-top:8px;display:flex;gap:14px;flex-wrap:wrap;font-size:10px;color:var(--text-muted,#5A6B7C)">
    <% Object.entries(sysStatus.freshness).forEach(function(entry){ var k=entry[0], f=entry[1]; %>
    <span title="<%= f.mtime || 'N/A' %>">📦 <%= f.label %>
      <span style="color:<%= f.age_hours > 24 ? '#92400e' : '#16a34a' %>">
        <%= f.exists ? Math.round(f.age_hours*10)/10 + 'h' : '缺失' %>
      </span>
    </span>
    <% }); %>
  </div>
</div>
<% } %>

<div class="diagram">
  <%- body %>
  <div class="page-footer">
    📄 源文件：<code>docs/architecture.md</code> &nbsp;|&nbsp;
    版本：<%= version %> &nbsp;|&nbsp;
    此页由 Markdown 动态渲染，与源码自动同步
  </div>
</div>
</body>
</html>

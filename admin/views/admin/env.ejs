<%- include('../partials/layout-top') %>

<style>
  .env-page { max-width: 900px; margin: 0 auto; padding: 24px 16px; }
  .env-page h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
  .env-sub { color: var(--cr-text-secondary); font-size: 13px; margin-bottom: 20px; }
  .env-saved { background: var(--cr-health-pass-bg); border: 1px solid var(--cr-health-pass-border); color: var(--cr-health-pass); padding: 10px 14px; border-radius: var(--cr-radius); margin-bottom: 16px; font-size: 13px; }
  .env-card { background: var(--cr-surface); border: 1px solid var(--cr-border); border-radius: var(--cr-radius-lg); padding: 20px; margin-bottom: 20px; }
  .env-card h3 { font-size: 15px; font-weight: 600; margin: 0 0 4px; }
  .env-card .hint { font-size: 12px; color: var(--cr-text-secondary); margin: 0 0 16px; }
  .model-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .model-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: var(--cr-surface-alt); border: 1px solid var(--cr-border-light); border-radius: var(--cr-radius-sm); cursor: pointer; font-size: 13px; transition: border-color var(--cr-transition); }
  .model-item:hover { border-color: var(--cr-primary); }
  .model-item input[type="checkbox"] { accent-color: var(--cr-primary); }
  .model-item.off { opacity: 0.5; }
  .style-group-label { font-size: 12px; color: var(--cr-info); font-weight: 600; margin: 14px 0 6px; text-transform: none; }
  .style-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .style-item { display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: var(--cr-surface-alt); border: 1px solid var(--cr-border-light); border-radius: var(--cr-radius-sm); cursor: pointer; font-size: 13px; }
  .style-item input[type="radio"] { accent-color: var(--cr-primary); }
  .style-item.selected { border-color: var(--cr-primary); background: rgba(41,98,255,0.08); }
  .env-actions { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .btn-primary { background: var(--cr-primary); color: #fff; border: none; padding: 10px 22px; border-radius: var(--cr-radius); font-size: 14px; cursor: pointer; font-weight: 600; transition: opacity var(--cr-transition); }
  .btn-primary:hover { opacity: 0.9; }
  .btn-secondary { background: var(--cr-health-btn-bg); color: var(--cr-text); border: 1px solid var(--cr-health-btn-border); padding: 10px 18px; border-radius: var(--cr-radius); font-size: 14px; cursor: pointer; text-decoration: none; }
</style>

</head>
<body>
<%- include('../partials/nav', { active: 'env' }) %>

<div class="env-page">
  <h2>环境配置</h2>
  <div class="env-sub">14 个 scanner 策略模型开关 + 偏好交易风格（Hermes agents/skills → 模型 / routing → 调度）</div>

  <% if (saved) { %>
    <div class="env-saved">✅ 配置已保存并落盘 data/env-config.json</div>
  <% } %>

  <form method="POST" action="/admin/env">
    <!-- 模型开关 -->
    <div class="env-card">
      <h3>策略模型开关</h3>
      <p class="hint">关闭后，scanner 调度将不再运行对应模型（scanner_signal_runner 读取本配置）。当前共 14 个模型。</p>
      <div class="model-grid">
        <% models.forEach(m => { const on = config.models[m.key]; %>
          <label class="model-item <%= on ? '' : 'off' %>">
            <input type="checkbox" name="models[<%= m.key %>]" <%= on ? 'checked' : '' %>>
            <span><%= m.name %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- 交易风格偏好 -->
    <div class="env-card">
      <h3>偏好交易风格</h3>
      <p class="hint">/m 看板按此风格对信号排序（仅排序，不隐藏其他风格信号）。选择「无偏好」则保持默认排序。</p>
      <div class="style-grid">
        <label class="style-item <%= config.style_preference === '' ? 'selected' : '' %>">
          <input type="radio" name="style_preference" value="" <%= config.style_preference === '' ? 'checked' : '' %>>
          <span>无偏好</span>
        </label>
        <% Object.entries(styleGroups).forEach(([key, g]) => { %>
          <label class="style-item <%= config.style_preference === key ? 'selected' : '' %>">
            <input type="radio" name="style_preference" value="<%= key %>" <%= config.style_preference === key ? 'checked' : '' %>>
            <span><%= g.label %></span>
          </label>
        <% }) %>
      </div>
      <% Object.entries(styleGroups).forEach(([key, g]) => { %>
        <div class="style-group-label"><%= g.label %>：<%= g.models.join(' · ') %></div>
      <% }) %>
    </div>

    <div class="env-actions">
      <button type="submit" class="btn-primary">保存配置</button>
      <a href="/admin/env" class="btn-secondary">重置</a>
    </div>
  </form>
</div>

<%- include('../partials/layout-bottom') %>

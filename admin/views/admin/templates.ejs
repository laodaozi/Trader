<%- include('../partials/layout-top') %>
</head>
<body>
  <%- include('../partials/nav', { active: 'templates' }) %>

  <main class="container">
    <div class="toolbar">
      <h2 style="margin:0;font-size:18px;">写作模板管理</h2>
      <span class="count">已配置 <%= templates.filter(function(t){return t.hasContent;}).length %> / 共 <%= templates.length %> 套</span>
    </div>

    <% if (locals.success) { %>
      <div class="alert-success-tmpl"><%= success %></div>
    <% } %>

    <%
      var active = templates.filter(function(t){ return t.hasContent; });
      var inactive = templates.filter(function(t){ return !t.hasContent; });
    %>

    <!-- 已配置模板 -->
    <% if (active.length > 0) { %>
      <div class="tmpl-grid">
        <% active.forEach(function(t){ %>
          <a class="tmpl-card" href="/admin/templates/<%= encodeURIComponent(t.role) %>">
            <div class="tmpl-card-role"><%= t.role %></div>
            <div class="tmpl-card-preview"><%= t.preview || '（空模板）' %></div>
            <div class="tmpl-card-status"><%= t.hasContent ? '已加载' : '未配置' %></div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="cr-empty">
        <div class="cr-empty__icon">📝</div>
        <div class="cr-empty__title">暂无已配置模板</div>
        <div class="cr-empty__desc">下方「未配置模板」中点击任一角色即可编写写作模板。</div>
      </div>
    <% } %>

    <!-- 未配置模板（折叠隐藏） -->
    <% if (inactive.length > 0) { %>
      <details class="tmpl-inactive" style="margin-top:1.5rem;">
        <summary style="cursor:pointer;user-select:none;color:var(--cr-text-secondary);font-size:.9rem;padding:.5rem 0;">
          未配置模板（<%= inactive.length %>）— 点击展开配置
        </summary>
        <div class="tmpl-grid" style="margin-top:1rem;opacity:.75;">
          <% inactive.forEach(function(t){ %>
            <a class="tmpl-card" href="/admin/templates/<%= encodeURIComponent(t.role) %>" style="border-style:dashed;">
              <div class="tmpl-card-role"><%= t.role %></div>
              <div class="tmpl-card-preview">未配置，点击创建</div>
              <div class="tmpl-card-status">＋ 新建</div>
            </a>
          <% }); %>
        </div>
      </details>
    <% } %>
  </main>

<%- include('../partials/layout-bottom') %>
